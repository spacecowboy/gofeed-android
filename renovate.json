{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "semanticCommits": "enabled",
  "minimumReleaseAge": "14 days",
  "minimumReleaseAgeBuffer": "3 days",
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "*.yml"
      ],
      "matchStrings": [
        "go install golang.org/x/mobile/cmd/gomobile@(?<currentValue>.*?)\\s"
      ],
      "depNameTemplate": "golang.org/x/mobile",
      "datasourceTemplate": "go"
    }
  ]
}
